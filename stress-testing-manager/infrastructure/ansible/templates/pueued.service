# /etc/systemd/system/pueued.service
[Unit]
Description=Pueue Daemon
After=network.target

[Service]
Type=simple
Restart=on-failure
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
SyslogIdentifier=pueued
Environment="HOME=/home/ubuntu"
Environment="PATH=/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
# Baseline env for tasks the daemon runs. Note: `pueue add` snapshots the
# enqueueing shell's environment, so per-job values normally come from there;
# these are a fallback.
Environment="SLACK_TOKEN={{ slack_token }}"
Environment="SLACK_CHANNEL_ID={{ slack_channel_id }}"
ExecStart=/home/ubuntu/.cargo/bin/pueued -vv

[Install]
WantedBy=multi-user.target
