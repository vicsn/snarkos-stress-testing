# /etc/systemd/system/pueued.service
[Unit]
Description=Pueue Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/bin/mkdir -p /home/ubuntu/.local/share/pueue
ExecStartPre=/bin/chown ubuntu:ubuntu /home/ubuntu/.local/share/pueue
ExecStart=/home/ubuntu/.cargo/bin/pueued -vv
Restart=on-failure
SyslogIdentifier=pueued

[Install]
WantedBy=multi-user.target
