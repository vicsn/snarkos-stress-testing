[Unit]
Description=snarkOS Node Service
After=network.target

[Service]
User=root
WorkingDirectory=/home/ubuntu
Environment="FIRST_NODE_IP={{ ansible_env.FIRST_NODE_IP }}"
Environment="VERBOSITY={{ ansible_env.VERBOSITY }}"
Environment="NODE_ID={{ ansible_env.NODE_ID }}"
Environment="NUM_INSTANCES={{ ansible_env.NUM_INSTANCES }}"
ExecStart=/usr/bin/snarkos start --metrics --nodisplay --bft 0.0.0.0:5000 --rest 0.0.0.0:3030 --node 0.0.0.0:4130 --peers {% for peer_ip in peer_ips %}{{ peer_ip }}:4130{% if not loop.last %},{% endif %}{% endfor %} --validators ${FIRST_NODE_IP}:5000 --verbosity ${VERBOSITY} --dev ${NODE_ID} --dev-num-validators ${NUM_INSTANCES} --rest-rps 9999999 --validator
Restart=no

[Install]
WantedBy=multi-user.target
