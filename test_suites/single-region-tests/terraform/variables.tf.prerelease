    { type = var.client_instance_type, count = var.client_instance_count, validator = 30 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 31 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 32 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 33 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 34 },
