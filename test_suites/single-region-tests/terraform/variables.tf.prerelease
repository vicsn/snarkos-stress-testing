    { type = var.client_instance_type, count = var.client_instance_count, validator = 15 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 16 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 17 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 18 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 19 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 20 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 21 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 22 },
