variable "owner" {
  description = "Identifier for the user or team deploying this infrastructure"
  type        = string
}

variable "devnet_name" {
  description = "Unique name for this devnet deployment"
  default     = "single-region-tests"
}

variable "validator_instance_type" {
  description = "Instance type for snarkOS validators"
  default     = "m7i.16xlarge"
}

variable "client_instance_type" {
  description = "Instance type for snarkOS validators"
  default     = "m7i.8xlarge"
}

variable "prover_instance_type" {
  description = "Instance type for snarkOS provers"
  default     = "m7i.2xlarge"
}

variable "tx_runner_instance_type" {
  description = "Instance type for the TX Runner node. The TX runner is heavy on CPU as it triggers highly concurrent snarkos tasks, so it is good for it to be C-type (compute optimized)"
  default     = "c7i.8xlarge"
}

variable "validator_instance_count" {
  description = "Number of snarkOS validators"
  default     = 40 # minimum 5 for prerelease tests
}

variable "client_instance_count" {
  description = "Number of snarkOS clients per validator"
  default     = 0 # More would surpass vCPU limit
}

variable "prover_instance_count" {
  description = "Number of snarkOS provers"
  default     = 0 # lower or equal to the number of validators
}

variable "RELEASE_BUCKET" {
  description = "The bucket used to upload and download SnarkOS binaries"
  default     = "provable-binaries-releases"
}

# ------------------------------------------------
# Clients

locals {
  snarkos_network = "testnet" # Note: only canary/testnet can have a large validator set - make sure this is aligned with vars.yml

  client_instance_config = [
    { type = var.client_instance_type, count = var.client_instance_count, validator = 0 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 1 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 2 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 3 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 4 }
  ]

  snarkos_clients = flatten([
    for config_idx, config in local.client_instance_config : [
      for i in range(config.count) : {
        type = config.type,
        index = i,
        validator = config.validator
      }
    ]
  ])
}
