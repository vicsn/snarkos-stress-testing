variable "owner" {
  description = "Identifier for the user or team deploying this infrastructure"
  type        = string
}

variable "devnet_name" {
  description = "Unique name for this devnet deployment"
  default     = "single-region-tests"
}

variable "validator_instance_type" {
  description = "Instance type for snarkOS validators"
  default     = "m7i.8xlarge"
}

variable "client_instance_type" {
  description = "Instance type for snarkOS validators"
  default     = "m7i.8xlarge"
}

variable "validator_instance_count" {
  description = "Number of snarkOS validators"
  default     = 40
}

variable "client_instance_count" {
  description = "Number of snarkOS clients per validator"
  default     = 1 # More would surpass vCPU limit
}

variable "RELEASE_BUCKET" {
  description = "The bucket used to upload and download SnarkOS binaries"
  default     = "release-bucket-2122415"
}

# ------------------------------------------------
# Clients

locals {
  snarkos_network = "testnet" # Note: some tx-cannons below only work for mainnet. The heavy network may be larger than the max mainnet validator set size, though.

  client_instance_config = [
    { type = var.client_instance_type, count = var.client_instance_count, validator = 0 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 1 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 2 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 3 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 4 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 5 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 6 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 7 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 8 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 9 },
    { type = var.client_instance_type, count = var.client_instance_count, validator = 10 }
  ]

  snarkos_clients = flatten([
    for config_idx, config in local.client_instance_config : [
      for i in range(config.count) : {
        type = config.type,
        index = i,
        validator = config.validator
      }
    ]
  ])
}

# ------------------------------------------------
# ECS Cannons

variable "existing_cluster_name" {
  description = "Name of the existing ECS cluster to use"
  default     = "tx-cannon"
  type        = string
}

variable "ecr_repository_url" {
  description = "URL of the ECR repository containing the tx-cannon image"
  default     = "637423331354.dkr.ecr.us-east-1.amazonaws.com/tx-cannon"
}

# tx_cannon_services
variable "tx_cannon_services" {
  description = "Map of tx-cannon services with their respective commands and task counts"
  type = map(object({
    tx_command = string
    task_count = number
  }))
  default = {
    BatchTransfer = {
      tx_command = "tx-cannon batch-transfer -r 90000001 --funding-account APrivateKey1zkp2GUmKbVsuc1NSj28pa1WTQuZaK5f1DQJAT6vPcHyWokG --amount 1 -a aleo1ashyu96tjwe63u0gtnnv8z5lhapdu4l5pjsl2kha7fv7hvz2eqxs5dz0rg --network"
      task_count = 1
    }
    BatchDeploy = {
      tx_command = "tx-cannon batch-deploy --manifest tests/1_deploy_2_seconds/300k_constraints/programs_to_deploy/programs_1.txt -a APrivateKey1zkp2GUmKbVsuc1NSj28pa1WTQuZaK5f1DQJAT6vPcHyWokG,APrivateKey1zkp2RWGDcde3efb89rjhME1VYA8QMxcxep5DShNBR6n8Yjh,APrivateKey1zkp2GUmKbVsuc1NSj28pa1WTQuZaK5f1DQJAT6vPcHyWokG --randomize --redeploys 10000000 --concurrent-deployments 3 --network"
      task_count = 1
    }
    InvalidSolutions = {
      tx_command = "tx-cannon generate-solutions -c 1000 -a aleo1s3ws5tra87fjycnjrwsjcrnw2qxr8jfqqdugnf0xzqqw29q9m5pqem2u4t --garbage --network"
      task_count = 1
    }
    ValidSolutions = {
      tx_command = "tx-cannon generate-solutions -c 1000 -a aleo1s3ws5tra87fjycnjrwsjcrnw2qxr8jfqqdugnf0xzqqw29q9m5pqem2u4t --network"
      task_count = 1
    }
    RejectedAborted = {
      tx_command = "tx-cannon malice -k APrivateKey1zkp2GUmKbVsuc1NSj28pa1WTQuZaK5f1DQJAT6vPcHyWokG --deployment-manifest tests/1_deploy_2_seconds/300k_constraints/programs_to_deploy/programs_2.txt --repetitions 900000 --underreport-variables 20 --network"
      task_count = 1
    }
    BatchBond1 = {
      tx_command = "tx-cannon batch-bond --delegator-start-index 0 --num-delegators 2570 -f APrivateKey1zkp2GUmKbVsuc1NSj28pa1WTQuZaK5f1DQJAT6vPcHyWokG --num-validators 10 --fund-amount 100100000000 --bond-amount 100000000000 -c 3 --network"
      task_count = 1
    }
    BatchBond2 = {
      tx_command = "tx-cannon batch-bond --delegator-start-index 2571 --num-delegators 2570 -f APrivateKey1zkp2GUmKbVsuc1NSj28pa1WTQuZaK5f1DQJAT6vPcHyWokG --num-validators 10 --fund-amount 100100000000 --bond-amount 100000000000 -c 3 --network"
      task_count = 1
    }
    BlockRequest = {
      tx_command = "tx-cannon request block --start 0 --end 105 -r 900000000 --network"
      task_count = 0 # NOTE: recommended set to 0 when shooting straight at validators
    }
    FakeTransfer = {
      tx_command = "tx-cannon batch-transfer -r 90000001 --funding-account APrivateKey1zkp2GUmKbVsuc1NSj28pa1WTQuZaK5f1DQJAT6vPcHyWokG --amount 0.000001 -a aleo1dlndvxrkpc20wt2kwm42cl6r28w8nghe7y67g6qdeyx0fn7t8q9sjw3nf8 --fake --network"
      task_count = 0 # NOTE: recommended set to 0 when shooting straight at validators
    }

    #BatchNestedExecute_1_31_1 = {# Note: only works for mainnet, requires running the add_deployments test
    #  tx_command = "tx-cannon batch-execute --test tests/nested_imports/execution_1_31_1.toml --network"
    #  task_count = 1
    #}

    #BatchNestedExecute_1_5_2 = { # Note: only works for mainnet, requires running the add_deployments test
    #  tx_command = "tx-cannon batch-execute --test tests/nested_imports/execution_1_5_2.toml --network"
    #  task_count = 1
    #}
    
    BatchRecordFund_2_30_1 = {
      tx_command = "tx-cannon batch-execute --test tests/nested_imports/funding_execution_2_30_1.toml --network"
      task_count = 1
    }
    #BatchNestedExecute_2_30_1 = { # Note: only works for mainnet, requires running the add_deployments test
    #  tx_command = "tx-cannon batch-execute --test tests/nested_imports/execution_2_30_1.toml --network"
    #  task_count = 1
    #}

    BatchRecordFund_2_4_2 = {
      tx_command = "tx-cannon batch-execute --test tests/nested_imports/funding_execution_2_4_2.toml --network"
      task_count = 1
    }
    #BatchNestedExecute_2_4_2 = { # Note: only works for mainnet, requires running the add_deployments test
    #  tx_command = "tx-cannon batch-execute --test tests/nested_imports/execution_2_4_2.toml --network"
    #  task_count = 1
    #}

    ProgramProbe = {
      tx_command = "tx-cannon program-probe --wait 100 --randomize --network"
      task_count = 1
    }

    # Add more services as needed
    # tx-cannon malice -k APrivateKey1zkp8CZNn3yeCseEtxuVPbDCwSyhGW6yZKUYKfgXmcpoGPWH --redeploy --double-spend --duplicate-transitions --deployment-manifest tests/1_deploy_2_seconds/300k_constraints/programs_to_deploy/programs_2.txt --underreport-constraints 10 --repetitions 90000000000001
    
    # the following require running add_deployments
