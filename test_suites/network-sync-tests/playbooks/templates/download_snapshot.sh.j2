{% raw %}#!/bin/bash
# Download a snapshot (HTTP/S, s3://, or gs://), extract (.tar, .tar.gz, .zip),
# and install it for snarkOS, flattening at the folder that contains 'CURRENT'.

set -euo pipefail

# --- Config / Logging ---
LOG_DIR="/home/ubuntu/logs"
LOG_FILE="${LOG_DIR}/snapshot_$(date +%Y%m%d-%H%M%S).log"
mkdir -p "$LOG_DIR"
touch "$LOG_FILE"

log() {
  local timestamp
  timestamp=$(date "+%Y-%m-%d %H:%M:%S")
  echo "[$timestamp] $1" | tee -a "$LOG_FILE"
}

log "=== Starting snapshot download and installation process ==="
log "Script initiated at $(date)"
{% endraw %}
SNAPSHOT_URL="{{ (snapshot_url | default('') | regex_replace('\r',''))
                 .split('\n')
                 | first
                 | regex_replace('^\\s+|\\s+$','') }}"
LOAD_LEDGER_TESTING="{{ (load_ledger_testing | default(false) | bool) | ternary('true','false') }}"
LEDGER_DIR="ledger-{{ snarkos_network_int | default(1) }}"
{% raw %}
DOWNLOAD_DIR="/tmp/snapshot_download"
EXTRACT_DIR="/tmp/snapshot_extract"
ALEO_DIR="/home/ubuntu/.aleo"
STORAGE_DIR="${ALEO_DIR}/storage"

TAR_COMMON_OPTS=(--no-same-owner --no-same-permissions --numeric-owner)

# Clear EXTRACT_DIR at exit only after a successful ledger install (see cleanup section).
CLEANUP_EXTRACT_DIR=false

# Make gsutil visible (installed via /usr/local/google-cloud-sdk)
export PATH=/usr/local/google-cloud-sdk/bin:$PATH

# --- snarkOS helpers ---
report_snarkos_status() {
  local lines="${1:-50}"
  log "snarkOS service status:"
  systemctl status snarkos | tee -a "$LOG_FILE" || true
  if systemctl is-active --quiet snarkos; then
    log "snarkOS service is running successfully"
  else
    log "WARNING: snarkOS service failed to start, showing recent logs:"
    journalctl -u snarkos --no-pager -n "$lines" | tee -a "$LOG_FILE" || true
  fi
}

restart_snarkos_and_report() {
  log "Restarting snarkOS service..."
  systemctl restart snarkos || true
  sleep 5
  report_snarkos_status 50
}

# --- Archive helpers (classify → extract; used for download and nested unwrap) ---
classify_archive_by_magic() {
  local path="$1"
  local fd
  fd=$(file -b "$path")
  if echo "$fd" | grep -qi 'zip archive'; then echo zip
  elif echo "$fd" | grep -qi 'gzip compressed data'; then echo gzip
  elif echo "$fd" | grep -qi 'xz compressed data'; then echo xz
  elif echo "$fd" | grep -qi 'bzip2 compressed data'; then echo bzip2
  elif echo "$fd" | grep -qi 'zstandard compressed data'; then echo zstd
  elif echo "$fd" | grep -qi 'tar archive'; then echo tar
  else echo unknown
  fi
}

classify_archive() {
  local path="$1"
  local lc
  lc=$(printf '%s' "${path##*/}" | tr '[:upper:]' '[:lower:]')
  case "$lc" in
    *.zip) echo zip ;;
    *.tar.gz|*.tgz) echo gzip ;;
    *.tar.xz) echo xz ;;
    *.tar.bz2|*.tbz|*.tbz2) echo bzip2 ;;
    *.tar.zst) echo zstd ;;
    *.tar) classify_archive_by_magic "$path" ;;
    *) classify_archive_by_magic "$path" ;;
  esac
}

extract_tar_zst() {
  local src="$1" dest="$2"
  if tar --help 2>&1 | grep -q -- '--zstd'; then
    tar "${TAR_COMMON_OPTS[@]}" --zstd -xf "$src" -C "$dest" 2> >(tee -a "$LOG_FILE" >&2)
  elif command -v zstd >/dev/null 2>&1; then
    zstd -dc "$src" | tar "${TAR_COMMON_OPTS[@]}" -xf - -C "$dest" 2> >(tee -a "$LOG_FILE" >&2)
  elif command -v unzstd >/dev/null 2>&1; then
    unzstd -c "$src" | tar "${TAR_COMMON_OPTS[@]}" -xf - -C "$dest" 2> >(tee -a "$LOG_FILE" >&2)
  else
    log "ERROR: zstd not installed and tar lacks --zstd"; return 1
  fi
}

extract_archive() {
  local src="$1" dest="$2"
  local kind
  kind=$(classify_archive "$src")
  log "Extracting archive (kind=$kind): $(basename "$src") → $dest"
  case "$kind" in
    zip)
      unzip -q -o "$src" -d "$dest" 2> >(tee -a "$LOG_FILE" >&2) ;;
    gzip)
      tar "${TAR_COMMON_OPTS[@]}" -xzf "$src" -C "$dest" 2> >(tee -a "$LOG_FILE" >&2) ;;
    xz)
      tar "${TAR_COMMON_OPTS[@]}" -xJf "$src" -C "$dest" 2> >(tee -a "$LOG_FILE" >&2) ;;
    bzip2)
      tar "${TAR_COMMON_OPTS[@]}" -xjf "$src" -C "$dest" 2> >(tee -a "$LOG_FILE" >&2) ;;
    zstd)
      extract_tar_zst "$src" "$dest" ;;
    tar)
      tar "${TAR_COMMON_OPTS[@]}" -xf "$src" -C "$dest" 2> >(tee -a "$LOG_FILE" >&2) ;;
    unknown)
      log "ERROR: Unsupported archive type: $(file -b "$src")"
      return 1 ;;
  esac
}

unwrap_nested_archives() {
  local max_iters=12
  local iter inner
  for (( iter = 0; iter < max_iters; iter++ )); do
    if [[ -n "$(find "$EXTRACT_DIR" -type f -name CURRENT -print -quit 2>/dev/null)" ]]; then
      log "Found CURRENT after nested unwrap (iteration $iter)"
      return 0
    fi

    mapfile -d '' -t inner < <(
      find "$EXTRACT_DIR" -mindepth 1 -maxdepth 1 -type f \
        \( -name '*.tar' -o -name '*.tar.gz' -o -name '*.tgz' -o -name '*.tar.xz' \
        -o -name '*.tar.bz2' -o -name '*.tbz' -o -name '*.tbz2' -o -name '*.tar.zst' \
        -o -name '*.zip' \) -print0 2>/dev/null
    )

    if [[ ${#inner[@]} -eq 0 ]]; then
      return 0
    fi
    if [[ ${#inner[@]} -gt 1 ]]; then
      log "WARNING: ${#inner[@]} top-level archives under $EXTRACT_DIR and still no CURRENT; skipping auto-unwrap. Files:"
      printf '%s\n' "${inner[@]}" | tee -a "$LOG_FILE"
      return 0
    fi

    inner="${inner[0]}"
    log "No CURRENT yet; unwrapping nested archive (iteration $((iter + 1))/${max_iters}): $inner"
    if ! extract_archive "$inner" "$EXTRACT_DIR"; then
      log "ERROR: Failed to extract nested archive: $inner"
      return 1
    fi
    log "Removing nested archive after successful extraction: $inner"
    rm -f "$inner"
  done
  log "WARNING: Stopped nested unwrap after ${max_iters} iterations without finding CURRENT."
  return 0
}

log "Creating necessary directories"
mkdir -p "$DOWNLOAD_DIR" "$EXTRACT_DIR"
log "Created: $DOWNLOAD_DIR and $EXTRACT_DIR"

if [[ -z "${SNAPSHOT_URL:-}" ]]; then
  log "No snapshot URL provided; exiting."

  mkdir -p "${STORAGE_DIR}/${LEDGER_DIR}"

  restart_snarkos_and_report

  exit 0
fi

# --- Download ---
log "Snapshot URL: $SNAPSHOT_URL"

FILENAME=$(basename "$SNAPSHOT_URL" | sed 's/[[:space:]]*$//')
DEST_FILE="$DOWNLOAD_DIR/$FILENAME"
log "Target local file: $DEST_FILE"

mkdir -p "$DOWNLOAD_DIR"

if [[ "$SNAPSHOT_URL" == gs://* ]]; then
  log "Detected GCS source; using gsutil cp to download archive"

  if ! command -v gsutil >/dev/null 2>&1; then
    log "ERROR: gsutil not found in PATH. Install Google Cloud SDK / gsutil first."
    exit 1
  fi

  max_attempts=5
  attempt=1
  success=0
  while (( attempt <= max_attempts )); do
    log "gsutil cp attempt ${attempt}/${max_attempts}..."
    ATTEMPT_LOG="$DOWNLOAD_DIR/gsutil_cp_$(date +%s)_${attempt}.log"

    if gsutil cp "$SNAPSHOT_URL" "$DEST_FILE" \
         2>&1 | tee -a "$ATTEMPT_LOG" -a "$LOG_FILE"; then
      log "GCS download complete: $DEST_FILE"
      rm -f "$ATTEMPT_LOG"
      success=1
      break
    fi

    log "gsutil cp failed on attempt ${attempt}. Relevant error lines:"
    grep -iE 'Exception|Error|denied|not found|ServiceException' "$ATTEMPT_LOG" \
      | tail -n 40 | tee -a "$LOG_FILE" || true

    rm -f "$ATTEMPT_LOG"
    attempt=$((attempt + 1))
    if (( attempt <= max_attempts )); then
      log "Retrying gsutil cp in 10s..."
      sleep 10
    fi
  done

  if (( success == 0 )); then
    log "ERROR: gsutil cp failed for $SNAPSHOT_URL after ${max_attempts} attempts."
    exit 1
  fi

elif [[ "$SNAPSHOT_URL" == s3://* ]]; then
  log "Detected S3 source; using aws s3 cp"

  if ! command -v aws >/dev/null 2>&1; then
    log "ERROR: aws CLI not found in PATH."
    exit 1
  fi

  if aws s3 cp "$SNAPSHOT_URL" "$DEST_FILE" 2>&1 | tee -a "$LOG_FILE"; then
    log "S3 download complete: $DEST_FILE"
  else
    log "ERROR: aws s3 cp failed for $SNAPSHOT_URL"
    exit 1
  fi
else
    # -------- Robust HTTP(S) downloader with rotation detection + infinite retry --------
    if ! command -v aria2c >/dev/null 2>&1; then
      log "ERROR: aria2c not found in PATH."
      exit 1
    fi

    # We fingerprint the remote (ETag/Last-Modified/Content-Length). If it changes, we purge
    # any local partial and start clean. We also watch for aria2 "Invalid range header" or
    # "content length mismatch" and purge/retry forever.
    FPRINT="$DOWNLOAD_DIR/${FILENAME}.fprint"

    fingerprint() {
      curl -sI --connect-timeout 20 --max-time 60 \
           -H "Cache-Control: no-cache" -H "Pragma: no-cache" \
           "$SNAPSHOT_URL" \
      | awk 'BEGIN{IGNORECASE=1}
             /^ETag:/           { gsub("\r",""); print "ETag:"$2 }
             /^Last-Modified:/  { sub("\r","");  print "LM:" substr($0,16) }
             /^Content-Length:/ { sub("\r","");  print "CL:" $2 }'
    }

    remote_fp="$(fingerprint)"
    local_fp="$(cat "$FPRINT" 2>/dev/null || echo "")"
    if [ "$remote_fp" != "$local_fp" ]; then
      log "Remote snapshot fingerprint changed. Purging local file/partials."
      rm -f "$DEST_FILE" "$DEST_FILE.aria2"
      printf "%s\n" "$remote_fp" > "$FPRINT"
    fi

    while true; do
      log "Downloading with aria2c…"
      # Use tee into a small, per-attempt log to detect specific failures reliably.
      ATTEMPT_LOG="$DOWNLOAD_DIR/aria2_$(date +%s).log"
      if aria2c \
          -x16 -s16 \
          --dir="$DOWNLOAD_DIR" \
          --out="$FILENAME" \
          --continue=true \
          --always-resume=false \
          --allow-overwrite=true \
          --auto-file-renaming=false \
          --max-tries=0 \
          --retry-wait=10 \
          --max-file-not-found=0 \
          --file-allocation=falloc \
          --timeout=120 \
          --connect-timeout=20 \
          --console-log-level=warn \
          --summary-interval=10 \
          --enable-http-keep-alive=true \
          --enable-http-pipelining=true \
          --socket-recv-buffer-size=4M \
          --max-connection-per-server=16 \
          --header="Cache-Control: no-cache" \
          --header="Pragma: no-cache" \
          "$SNAPSHOT_URL" 2>&1 | tee -a "$ATTEMPT_LOG" -a "$LOG_FILE"; then
        log "HTTP download complete: $DEST_FILE"
        rm -f "$ATTEMPT_LOG"
        break
      fi

      # If we hit a range mismatch (snapshot rotated under us), purge and retry.
      if grep -qiE 'Invalid range header|content length mismatch' "$ATTEMPT_LOG"; then
        log "Detected range/content mismatch. Purging local file/partials and retrying…"
        rm -f "$DEST_FILE" "$DEST_FILE.aria2"
        # Refresh fingerprint (CDN may have just rotated again)
        new_fp="$(fingerprint)"
        if [ "$new_fp" != "$remote_fp" ]; then
          printf "%s\n" "$new_fp" > "$FPRINT"
          remote_fp="$new_fp"
        fi
        rm -f "$ATTEMPT_LOG"
        sleep 5
        continue
      fi

      log "aria2c failed; retrying in 15s…"
      rm -f "$ATTEMPT_LOG"
      sleep 15
    done
    # -------- end robust HTTP(S) downloader --------
fi

log "File size: $(du -h "$DEST_FILE" | cut -f1)"
FILE_DESC=$(file -b "$DEST_FILE")
log "File type: $FILE_DESC"

# --- Extract / Prepare EXTRACT_DIR ---
extract_ok=false

log "Cleaning extraction directory"
rm -rf "$EXTRACT_DIR"/*
log "Extracting snapshot archive..."

if extract_archive "$DEST_FILE" "$EXTRACT_DIR"; then
  extract_ok=true
fi

if $extract_ok; then
  if ! unwrap_nested_archives; then
    log "ERROR: Nested archive unwrap failed."
    exit 1
  fi
fi

if ! $extract_ok; then
  log "ERROR: Extraction failed."
  exit 1
fi

log "Successfully prepared snapshot contents in $EXTRACT_DIR"
log "Extracted files (top level):"
ls -la "$EXTRACT_DIR" | tee -a "$LOG_FILE"

# --- Locate the ledger root by the CURRENT file and install it (flatten at CURRENT level) ---

# 1) Find any file named CURRENT in the extracted tree
mapfile -t CURRENT_HITS < <(find "$EXTRACT_DIR" -type f -name CURRENT 2>/dev/null | sort)

if [[ "$LOAD_LEDGER_TESTING" == "true" ]]; then
  log "LOAD_LEDGER_TESTING=true → skipping ledger install, service stop/start, and cleanup."
  log "Found CURRENT hits: ${#CURRENT_HITS[@]}"
  for p in "${CURRENT_HITS[@]}"; do
    log " - $p"
  done
  log "Early exit due to load ledger testing mode."
  exit 0
fi

if [[ ${#CURRENT_HITS[@]} -eq 0 ]]; then
  log "WARNING: No 'CURRENT' file found after extraction. Showing tree for debugging:"
  find "$EXTRACT_DIR" -maxdepth 4 -type d | sed "s|^|  |" | tee -a "$LOG_FILE"
  log "Proceeding to restart snarkOS without ledger replacement."
else
  rm -rf "$DOWNLOAD_DIR"/*

  # gs:// archives: ledger lives at ${EXTRACT_DIR}/block_storage_snapshot/${LEDGER_DIR}/.
  GCS_LEDGER_ROOT="${EXTRACT_DIR}/block_storage_snapshot/${LEDGER_DIR}"
  LEDGER_ROOT=""
  if [[ "$SNAPSHOT_URL" == gs://* ]] && [[ -f "${GCS_LEDGER_ROOT}/CURRENT" ]]; then
    LEDGER_ROOT="$GCS_LEDGER_ROOT"
    log "Using GCS snapshot layout: block_storage_snapshot/${LEDGER_DIR}/"
  else
    # Prefer a path that includes '/${LEDGER_DIR}/'; otherwise pick the shortest path
    for p in "${CURRENT_HITS[@]}"; do
      if [[ "$p" == *"/${LEDGER_DIR}/"* || "$p" == *"/${LEDGER_DIR}/CURRENT" ]]; then
        LEDGER_ROOT="$(dirname "$p")"
        break
      fi
    done
    if [[ -z "$LEDGER_ROOT" ]]; then
      shortest="${CURRENT_HITS[0]}"
      for p in "${CURRENT_HITS[@]}"; do
        [[ ${#p} -lt ${#shortest} ]] && shortest="$p"
      done
      LEDGER_ROOT="$(dirname "$shortest")"
    fi
  fi

  log "Detected ledger root (folder containing CURRENT): $LEDGER_ROOT"
  log "Ledger root size: $(du -sh "$LEDGER_ROOT" | cut -f1)"

  # 2) Stop snarkOS and prepare destination
  log "Stopping snarkOS service..."
  systemctl stop snarkos || true
  systemctl status snarkos || true

  mkdir -p "$STORAGE_DIR"

  # 3) Backup existing ledger if present
  if [[ -d "${STORAGE_DIR}/${LEDGER_DIR}" ]]; then
    BACKUP_NAME="${LEDGER_DIR}-backup-$(date +%Y%m%d-%H%M%S)"
    log "Backing up existing ledger to ${STORAGE_DIR}/${BACKUP_NAME}"
    log "Current ledger size: $(du -sh "${STORAGE_DIR}/${LEDGER_DIR}" | cut -f1)"
    mv "${STORAGE_DIR}/${LEDGER_DIR}" "${STORAGE_DIR}/${BACKUP_NAME}"
    log "Backup completed"
  else
    log "No existing ledger found at ${STORAGE_DIR}/${LEDGER_DIR}"
  fi

  # 4) Install: flatten contents from the CURRENT-level folder into storage
  log "Installing new ledger (flattened at CURRENT level) to ${STORAGE_DIR}/${LEDGER_DIR}"
  mkdir -p "${STORAGE_DIR}/${LEDGER_DIR}"

  if command -v rsync >/dev/null 2>&1; then
    # --delete keeps destination in sync with source
    rsync -a --delete "${LEDGER_ROOT}/" "${STORAGE_DIR}/${LEDGER_DIR}/" 2>&1 | tee -a "$LOG_FILE"
  else
    # Fallback without --delete semantics
    cp -a "${LEDGER_ROOT}/." "${STORAGE_DIR}/${LEDGER_DIR}/" 2>&1 | tee -a "$LOG_FILE"
  fi

  # Sanity check: ensure CURRENT exists at destination root now
  if [[ -f "${STORAGE_DIR}/${LEDGER_DIR}/CURRENT" ]]; then
    log "New ledger installed successfully."
    CLEANUP_EXTRACT_DIR=true
  else
    log "ERROR: 'CURRENT' not found at ${STORAGE_DIR}/${LEDGER_DIR} after install."
    exit 1
  fi

  log "New ledger size: $(du -sh "${STORAGE_DIR}/${LEDGER_DIR}" | cut -f1)"
  log "Available disk space on /: $(df -h / | awk 'NR==2 {print $4}')"
fi

# --- Restart service ---
restart_snarkos_and_report

# --- Cleanup ---
if [[ "$CLEANUP_EXTRACT_DIR" == "true" ]]; then
  log "Cleanup: removing contents of $EXTRACT_DIR (ledger install succeeded)."
  rm -rf "$EXTRACT_DIR"/*
else
  log "Cleanup: preserving $EXTRACT_DIR (no successful ledger install; inspect for debugging)."
fi

log "=== Script completed at $(date) ==="
log "Full log: $LOG_FILE"

exit 0
{% endraw %}
