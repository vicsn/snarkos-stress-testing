#!/bin/bash
# Script to download snapshot, untar it, and restart snarkOS service

# Set up logging
LOG_DIR="/var/log/aleo"
LOG_FILE="${LOG_DIR}/snapshot_$(date +%Y%m%d-%H%M%S).log"
mkdir -p "$LOG_DIR"
touch "$LOG_FILE"

# Log function to write to both console and log file
log() {
    local timestamp=$(date "+%Y-%m-%d %H:%M:%S")
    echo "[$timestamp] $1"
    echo "[$timestamp] $1" >> "$LOG_FILE"
}

log "=== Starting snapshot download and installation process ==="
log "Script initiated at $(date)"

SNAPSHOT_URL="{{ snapshot_url }}"
DOWNLOAD_DIR="/tmp/snapshot_download"
EXTRACT_DIR="/tmp/snapshot_extract"
ALEO_DIR="/root/.aleo"
STORAGE_DIR="${ALEO_DIR}/storage"

# Create directories if they don't exist
log "Creating necessary directories"
mkdir -p "$DOWNLOAD_DIR"
mkdir -p "$EXTRACT_DIR"
log "Created directories: $DOWNLOAD_DIR and $EXTRACT_DIR"

if [ -n "$SNAPSHOT_URL" ]; then
  log "Starting download of snapshot from $SNAPSHOT_URL"
  # Get filename and trim any trailing spaces
  FILENAME=$(basename "$SNAPSHOT_URL" | sed 's/[[:space:]]*$//')
  log "Target filename: '$FILENAME' (quotes shown to reveal any trailing spaces)"
  
  # Download with wget, using continue flag and progress bar
  log "Beginning download with wget..."
  wget -c --progress=bar:force "$SNAPSHOT_URL" -O "$DOWNLOAD_DIR/$FILENAME" 2>&1 | tee -a "$LOG_FILE"
  WGET_STATUS=${PIPESTATUS[0]}
  
  if [ $WGET_STATUS -eq 0 ]; then
    log "Download complete, checking file '$DOWNLOAD_DIR/$FILENAME'"
    log "File size: $(du -h "$DOWNLOAD_DIR/$FILENAME" | cut -f1)"
    log "File type: $(file "$DOWNLOAD_DIR/$FILENAME")"
    
    # Clean extract directory first
    log "Cleaning extraction directory"
    rm -rf "$EXTRACT_DIR"/*
    
    # Extract the file based on its actual format
    log "Extracting snapshot archive..."
    if file "$DOWNLOAD_DIR/$FILENAME" | grep -q "gzip"; then
      log "Detected gzipped tar archive, using tar -xzf"
      tar -xzf "$DOWNLOAD_DIR/$FILENAME" -C "$EXTRACT_DIR" 2>&1 | tee -a "$LOG_FILE"
      TAR_STATUS=${PIPESTATUS[0]}
    else
      log "Detected standard tar archive, using tar -xf"
      tar -xf "$DOWNLOAD_DIR/$FILENAME" -C "$EXTRACT_DIR" 2>&1 | tee -a "$LOG_FILE"
      TAR_STATUS=${PIPESTATUS[0]}
    fi
    
    if [ $TAR_STATUS -eq 0 ]; then
      log "Successfully extracted snapshot"
      
      # List what files were extracted
      log "Extracted files (top level):"
      ls -la "$EXTRACT_DIR" | tee -a "$LOG_FILE"
      
      # Find the ledger directory (pattern: ledger-0-*)
      LEDGER_SOURCE=$(find "$EXTRACT_DIR" -name "ledger-0-*" -type d)
      
      if [ -n "$LEDGER_SOURCE" ]; then
        log "Found ledger directory: $LEDGER_SOURCE"
        log "Ledger directory size: $(du -sh "$LEDGER_SOURCE" | cut -f1)"
        
        # Stop snarkOS service before modifying data
        log "Stopping snarkOS service to update ledger..."
        systemctl stop snarkos
        log "snarkOS service stopped, status:"
        systemctl status snarkos | tee -a "$LOG_FILE"
        
        # Create the destination directory if it doesn't exist
        mkdir -p "$STORAGE_DIR"
        
        # Back up existing ledger if it exists
        if [ -d "${STORAGE_DIR}/ledger-0" ]; then
          BACKUP_NAME="ledger-0-backup-$(date +%Y%m%d-%H%M%S)"
          log "Backing up existing ledger to ${STORAGE_DIR}/${BACKUP_NAME}"
          log "Current ledger size: $(du -sh "${STORAGE_DIR}/ledger-0" | cut -f1)"
          mv "${STORAGE_DIR}/ledger-0" "${STORAGE_DIR}/${BACKUP_NAME}"
          log "Backup completed"
        else
          log "No existing ledger found at ${STORAGE_DIR}/ledger-0"
        fi
        
        # Move the new ledger directory to the correct location
        log "Moving new ledger to ${STORAGE_DIR}/ledger-0"
        mv "$LEDGER_SOURCE" "${STORAGE_DIR}/ledger-0"
        log "New ledger installation complete"
        log "New ledger size: $(du -sh "${STORAGE_DIR}/ledger-0" | cut -f1)"
        log "Available disk space: $(df -h / | awk 'NR==2 {print $4}')"
      else
        log "WARNING: Could not find ledger-0-* directory in extracted files"
        log "Extract directory contents:"
        find "$EXTRACT_DIR" -type d | sort | tee -a "$LOG_FILE"
        # Continue anyway to restart service
      fi
    else
      log "ERROR: Failed to extract snapshot, tar exit code: $TAR_STATUS"
      # Continue anyway to restart service
    fi
  else
    log "ERROR: Download failed for $SNAPSHOT_URL, wget exit code: $WGET_STATUS"
    # Continue anyway to restart service
  fi
else
  log "No snapshot URL provided for this client, skipping download"
fi

# Restart snarkOS service
log "Restarting snarkOS service..."
systemctl restart snarkos
sleep 5
log "snarkOS service status after restart:"
systemctl status snarkos | tee -a "$LOG_FILE"

# Check if the service is actually running
if systemctl is-active --quiet snarkos; then
  log "snarkOS service is running successfully"
else
  log "WARNING: snarkOS service failed to start, check system logs"
  journalctl -u snarkos --no-pager -n 50 | tee -a "$LOG_FILE"
fi

# Cleanup
log "Cleanup: Do you want to remove downloaded and extracted files? (not removing for now)"
# Uncomment these lines if you want automatic cleanup
# log "Removing downloaded files: $DOWNLOAD_DIR/$FILENAME"
# rm -f "$DOWNLOAD_DIR/$FILENAME"
# log "Removing extracted files in $EXTRACT_DIR"
# rm -rf "$EXTRACT_DIR"/*

# Log completion
log "=== Script completed at $(date) ==="
log "Full log available at: $LOG_FILE"

exit 0